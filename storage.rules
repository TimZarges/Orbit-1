rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Standard: Alles verbieten
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isChatParticipant(chatId) {
      return request.auth != null && request.auth.uid in chatId.split('_');
    }

    // FIT-Uploads der Athleten (max 25 MB)
    match /users/{userId}/fit/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId 
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Downsampled Streams (nur Cloud Functions schreiben via Admin SDK, Nutzer darf lesen)
    match /users/{userId}/streams/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Unveränderte Originaldateien der Aktivitäten (.fit, .tcx, .gpx)
    // Zugriff für den Athleten selbst sowie für verbundene Trainer mit aktiver Freigabe
    match /users/{userId}/rawActivities/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (firestore.exists(/databases/(default)/documents/coachLinks/$(userId + '_' + request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/coachLinks/$(userId + '_' + request.auth.uid)).data.status == 'ACTIVE' &&
         firestore.get(/databases/(default)/documents/coachLinks/$(userId + '_' + request.auth.uid)).data.permissions.activities == true)
      );
      allow write: if false;
    }

    // Chat-Bilder (max 10 MB, Content-Type image/*)
    match /chats/{chatId}/images/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if isChatParticipant(chatId);
    }

    // Chat-Dateien (max 25 MB)
    match /chats/{chatId}/files/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
                   && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if isChatParticipant(chatId);
    }

    // Chat-Anhänge (Fallback für generische Anhänge, max 25 MB)
    match /chats/{chatId}/attachments/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
                   && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
      allow delete: if isChatParticipant(chatId);
    }

    // Beta-Bug-Reporter Screenshots (max 5 MB, nur eigene Uploads, image/*)
    match /betaFeedback/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
