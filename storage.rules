rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    
    // Standardmäßig alles verbieten
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Nutzer dürfen FIT-Dateien hochladen (max. 25 MB)
    match /users/{userId}/fit/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
                   && request.auth.uid == userId 
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Streams (Zeitreihen) dürfen nur vom Server geschrieben, aber vom Nutzer gelesen werden
    match /users/{userId}/streams/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Nur Cloud Functions (Admin SDK)
    }
    
    // Profilbilder (Platzhalter für später)
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
