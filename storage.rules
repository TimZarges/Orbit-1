rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Standard: Alles verbieten
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // FIT-Uploads der Athleten (max 25 MB)
    match /users/{userId}/fit/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId 
                   && request.resource.size < 25 * 1024 * 1024;
    }

    // Downsampled Streams (nur Cloud Functions schreiben via Admin SDK, Nutzer darf lesen)
    match /users/{userId}/streams/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
