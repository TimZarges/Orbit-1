[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "User-Agent",
      "x-goog-resumable",
      "X-Firebase-Storage-Version",
      "X-Firebase-Storage-XSRF"
    ],
    "maxAgeSeconds": 3600
  }
]
