rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users/{uid}
    // Fields: uid, email, createdAt, role, trainerVerified, coachId, profile, settings, consents, plan
    //
    // Collection: coachLinks/{linkId}
    // Fields: athleteId, coachId, status, permissions, createdAt, updatedAt
    //
    // Collection: invites/{code}
    // Fields: coachId, expiresAt, maxUses, usedBy
    //
    // Collection: activities/{activityId}
    // Fields: athleteId, coachId, ...
    //
    // Collection: plannedWorkouts/{workoutId}
    // Fields: athleteId, coachId, ...
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function checkStringSize(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function checkOptionalStringSize(val, minLen, maxLen) {
      return val == null || checkStringSize(val, minLen, maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUserDoc(data) {
      // Basic size checks to prevent 1MB DoS attacks
      let emailOk = !('email' in data) || checkStringSize(data.email, 3, 254);
      let roleOk = !('role' in data) || data.role in ["ATHLETE", "TRAINER"];
      
      return emailOk && roleOk;
    }

    function isValidUserCreate(data) {
      // Must not escalate privileges on creation
      let roleOk = !('role' in data) || data.role == 'ATHLETE';
      let verifiedOk = !('trainerVerified' in data) || data.trainerVerified == false;
      let coachOk = !('coachId' in data) || data.coachId == null;
      let uidOk = !('uid' in data) || data.uid == request.auth.uid;
      
      return isValidUserDoc(data) && roleOk && verifiedOk && coachOk && uidOk;
    }

    function isValidUserUpdate() {
      // Must not change critical server-side fields
      let protectedFieldsUnchanged = areImmutableFieldsUnchanged([
        'role', 'trainerVerified', 'coachId', 'uid', 'email', 'createdAt', 'metrics', 'metricsVersion'
      ]);
      return isValidUserDoc(request.resource.data) && protectedFieldsUnchanged;
    }

    function isCoachForHealth(userId) {
      let linkDoc = get(/databases/$(database)/documents/coachLinks/$(userId)_$(request.auth.uid));
      return linkDoc != null && linkDoc.data.permissions.health == true;
    }

    // ===============================================================
    // Security Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(request.resource.data);
      allow update: if isOwner(userId) && isValidUserUpdate();
      
      match /thresholdHistory/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }

      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }

      match /private/{privateId} {
        allow read, write: if false;
      }
      
      match /dailyMetrics/{date} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForHealth(userId));
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }
    }

    match /coachLinks/{linkId} {
      allow read: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow write: if false; // Only backend can write
    }

    match /invites/{code} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.athleteId == request.auth.uid; // Prototype
      allow update: if isAuthenticated() && resource.data.athleteId == request.auth.uid && request.resource.data.athleteId == resource.data.athleteId; // Prototype, immutable athleteId
      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;
    }

    match /plannedWorkouts/{workoutId} {
      allow read: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.athleteId == request.auth.uid; // Prototype
      allow update: if isAuthenticated() && resource.data.athleteId == request.auth.uid && request.resource.data.athleteId == resource.data.athleteId; // Prototype
      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;
    }
  }
}
