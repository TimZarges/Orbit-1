rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users/{uid}
    // Fields: uid, email, createdAt, role, trainerVerified, coachId, profile, settings, consents, plan
    //
    // Collection: coachLinks/{linkId}
    // Fields: athleteId, coachId, status, permissions, createdAt, updatedAt
    //
    // Collection: invites/{code}
    // Fields: coachId, expiresAt, maxUses, usedBy
    //
    // Collection: activities/{activityId}
    // Fields: athleteId, coachId, ...
    //
    // Collection: plannedWorkouts/{workoutId}
    // Fields: athleteId, coachId, createdBy, localDate, sport, title, status, plannedDurationSec, ...
    //
    // Subcollection: users/{uid}/aggregates/{date}
    // Fields: dailyLoad, ctl, atl, tsb, orbitScore, metricsVersion
    //
    // Subcollection: users/{uid}/bests/{sport}
    // Fields: allTime, currentSeason, sport, updatedAt
    //
    // Subcollection: users/{uid}/thresholdProposals/{proposalId}
    // Fields: sport, type, proposedValue, confidence, basis, status, createdAt, proposedBy, notes
    //
    // Collection: workoutTemplates/{templateId}
    // Fields: ownerId, visibility, sport, title, description, structure, tags, isFavorite, createdAt, updatedAt
    //
    // Collection: chats/{chatId}
    // Fields: athleteId, coachId, participants, lastMessage, updatedAt, unread, status
    //
    // Subcollection: chats/{chatId}/messages/{messageId}
    // Fields: senderId, type, status, text, attachment, activityShare, createdAt
    //
    // Subcollection: chats/{chatId}/state/{uid}
    // Fields: lastReadAt
    //
    // Subcollection: users/{uid}/devices/{deviceId}
    // Fields: fcmToken, platform, appVersion, language, updatedAt
    //
    // Subcollection: users/{uid}/notificationState/{docId}
    // Fields: nextReminderAtUtc, nextWeeklySummaryAtUtc
    //
    // Collection: coachDashboard/{coachId}/athletes/{athleteId}
    // Fields: athleteId, coachId, name, avatarUrl, sport, formStatus, ctl, atl, tsb, compliance7d, actualLoad7d, plannedLoad7d, unreadMessagesCount, pendingProposalsCount, latestActivity, raceGoal, alert, updatedAt
    //
    // Subcollection: users/{uid}/preferences/{prefId}
    // Fields: name, columns, filters, sort, ...
    //
    // Collection: betaFeedback/{reportId} (and beta_feedback/{reportId})
    // Fields: userId, category, description, includeDiagnostics, diagnostics, screenshotPath, ticketId, status, createdAt
    //
    // Collection: contactRequests/{requestId}
    // Fields: name, email, category, message, createdAt, status
    //
    // Collection: betaWaitlist/{entryId}
    // Fields: email, name, role, device, consentGiven, createdAt
    //
    // Subcollection: users/{uid}/races/{raceId}
    // Fields: title, date, priority, sport, distanceLabel, targetTimeSec, targetPowerWatts, notes, userId, createdAt, updatedAt
    //
    // Collection: app_config/{configId}
    // Fields: minRequiredBuild, latestBuild, updateUrl, maintenanceMode, featureFlags
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      );
    }
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function checkStringSize(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }
    function checkOptionalStringSize(val, minLen, maxLen) {
      return val == null || checkStringSize(val, minLen, maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUserDoc(data) {
      // Basic size checks to prevent 1MB DoS attacks
      let emailOk = !('email' in data) || checkStringSize(data.email, 3, 254);
      let roleOk = !('role' in data) || data.role in ["ATHLETE", "TRAINER"];
      
      return emailOk && roleOk;
    }

    function isValidUserCreate(data) {
      // Must not escalate privileges on creation
      let roleOk = !('role' in data) || data.role == 'ATHLETE';
      let verifiedOk = !('trainerVerified' in data) || data.trainerVerified == false;
      let coachOk = !('coachId' in data) || data.coachId == null;
      let uidOk = !('uid' in data) || data.uid == request.auth.uid;
      let adminOk = !('isAdmin' in data) || data.isAdmin == false;
      
      return isValidUserDoc(data) && roleOk && verifiedOk && coachOk && uidOk && adminOk;
    }

    function isValidUserUpdate() {
      // Must not change critical server-side fields
      let protectedFieldsUnchanged = areImmutableFieldsUnchanged([
        'role', 'trainerVerified', 'coachId', 'uid', 'email', 'createdAt', 'metrics', 'metricsVersion', 'notificationState', 'isAdmin'
      ]);
      return isValidUserDoc(request.resource.data) && protectedFieldsUnchanged;
    }

    function isValidWorkoutTemplate(data) {
      let visibilityOk = data.visibility in ['PRIVATE', 'SHARED_WITH_MY_ATHLETES', 'PUBLIC'];
      let titleOk = !('title' in data) || checkStringSize(data.title, 1, 200);
      let sportOk = !('sport' in data) || checkStringSize(data.sport, 1, 50);
      let descOk = !('description' in data) || checkStringSize(data.description, 0, 5000);
      let tagsOk = !('tags' in data) || (data.tags is list && data.tags.size() <= 50);
      return visibilityOk && titleOk && sportOk && descOk && tagsOk;
    }

    function isCoachForHealth(userId) {
      let linkDoc = get(/databases/$(database)/documents/coachLinks/$(userId + '_' + request.auth.uid));
      return linkDoc != null && linkDoc.data.status == 'ACTIVE' && linkDoc.data.permissions.health == true;
    }

    function isCoachForCalendar(athleteId) {
      let linkDoc = get(/databases/$(database)/documents/coachLinks/$(athleteId + '_' + request.auth.uid));
      return linkDoc != null && linkDoc.data.status == 'ACTIVE' && linkDoc.data.permissions.calendar == true;
    }

    function isCoachForActivities(athleteId) {
      let linkDoc = get(/databases/$(database)/documents/coachLinks/$(athleteId + '_' + request.auth.uid));
      return linkDoc != null && linkDoc.data.status == 'ACTIVE' && linkDoc.data.permissions.activities == true;
    }

    function isValidThresholdProposalUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let onlyStatusChanged = affected.hasOnly(['status']);
      let statusValid = request.resource.data.status in ['ACCEPTED', 'REJECTED'];
      let protectedFieldsUnchanged = areImmutableFieldsUnchanged([
        'sport', 'type', 'proposedValue', 'confidence', 'basis', 'createdAt', 'proposedBy'
      ]);
      return onlyStatusChanged && statusValid && protectedFieldsUnchanged;
    }

    function isValidCoachThresholdProposalCreate(data) {
      let hasRequired = 'proposedBy' in data && 'status' in data && 'sport' in data && 'proposedValue' in data;
      let proposedByOk = data.proposedBy == request.auth.uid;
      let statusOk = data.status == 'PENDING';
      let sportOk = data.sport in ['RUN', 'BIKE', 'SWIM'];
      let valueOk = data.proposedValue is number && data.proposedValue > 0;
      let typeOk = !('type' in data) || checkStringSize(data.type, 1, 50);
      let notesOk = !('notes' in data) || checkStringSize(data.notes, 0, 2000);
      let basisOk = !('basis' in data) || (data.basis is list && data.basis.size() <= 20);
      let sizeOk = data.keys().size() <= 30;
      return hasRequired && proposedByOk && statusOk && sportOk && valueOk && typeOk && notesOk && basisOk && sizeOk;
    }

    function isValidPreferenceDoc(data) {
      let nameOk = !('name' in data) || checkStringSize(data.name, 1, 200);
      let sizeOk = data.keys().size() <= 50;
      return nameOk && sizeOk;
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && request.auth.uid in chatId.split('_');
    }

    function isChatActive(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return exists(chatPath) && (!('status' in get(chatPath).data) || get(chatPath).data.status != 'REVOKED');
    }

    function isValidMessageCreate(data) {
      let hasRequired = 'senderId' in data && 'type' in data && 'status' in data;
      let typeOk = data.type in ['TEXT', 'IMAGE', 'FILE', 'ACTIVITY_SHARE'];
      let statusOk = data.status == 'SENT';
      let textOk = !('text' in data) || checkStringSize(data.text, 0, 10000);
      let attachmentOk = !('attachment' in data) || data.attachment is map;
      let activityShareOk = !('activityShare' in data) || data.activityShare is map;
      return hasRequired && typeOk && statusOk && textOk && attachmentOk && activityShareOk;
    }

    function isValidMessageUpdate() {
      let isSender = resource.data.senderId == request.auth.uid;
      let notAlreadyDeleted = !('status' in resource.data) || resource.data.status != 'DELETED';
      let isSoftDelete = request.resource.data.status == 'DELETED';
      let immutableUnchanged = areImmutableFieldsUnchanged(['senderId', 'createdAt', 'type']);
      let textOk = !('text' in request.resource.data) || checkStringSize(request.resource.data.text, 0, 10000);
      return isSender && notAlreadyDeleted && isSoftDelete && immutableUnchanged && textOk;
    }

    function isValidChatState(data) {
      let hasLastRead = 'lastReadAt' in data && data.lastReadAt is timestamp;
      let sizeOk = data.keys().size() <= 5;
      return hasLastRead && sizeOk;
    }

    function isValidDeviceDoc(data) {
      let tokenOk = 'fcmToken' in data && checkStringSize(data.fcmToken, 1, 1000);
      let platformOk = !('platform' in data) || checkStringSize(data.platform, 1, 50);
      let appVersionOk = !('appVersion' in data) || checkStringSize(data.appVersion, 1, 50);
      let languageOk = !('language' in data) || checkStringSize(data.language, 1, 20);
      return tokenOk && platformOk && appVersionOk && languageOk;
    }

    function isValidBetaFeedbackCreate(data) {
      let hasRequired = 'userId' in data && 'category' in data && 'description' in data;
      let userIdOk = data.userId == request.auth.uid;
      let categoryOk = data.category in ['BUG_CRASH', 'FEATURE_IDEA', 'SUPPORT_QUESTION', 'WRONG_CALCULATION', 'GARMIN_UPLOAD', 'DESIGN_SUGGESTION'];
      let descriptionOk = checkStringSize(data.description, 1, 5000);
      let includeDiagnosticsOk = !('includeDiagnostics' in data) || data.includeDiagnostics is bool;
      let diagnosticsOk = !('diagnostics' in data) || data.diagnostics == null || (data.diagnostics is map && data.diagnostics.keys().size() <= 15);
      let screenshotPathOk = !('screenshotPath' in data) || checkOptionalStringSize(data.screenshotPath, 1, 500);
      let ticketIdOk = !('ticketId' in data) || checkOptionalStringSize(data.ticketId, 1, 20);
      let statusOk = !('status' in data) || data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'];
      let sizeOk = data.keys().size() <= 15;
      return hasRequired && userIdOk && categoryOk && descriptionOk && includeDiagnosticsOk && diagnosticsOk && screenshotPathOk && ticketIdOk && statusOk && sizeOk;
    }

    function isValidContactRequest(data) {
      let hasRequired = 'name' in data && 'email' in data && 'message' in data;
      let nameOk = 'name' in data && checkStringSize(data.name, 1, 100);
      let emailOk = 'email' in data && checkStringSize(data.email, 5, 200);
      let messageOk = 'message' in data && checkStringSize(data.message, 1, 5000);
      let categoryOk = !('category' in data) || data.category in ['SUPPORT', 'BUG', 'FEEDBACK', 'PARTNERSHIP', 'OTHER'];
      let statusOk = !('status' in data) || data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'];
      let sizeOk = data.keys().size() <= 10;
      return hasRequired && nameOk && emailOk && messageOk && categoryOk && statusOk && sizeOk;
    }


    function isValidBetaWaitlistEntry(data) {
      return ('email' in data && 'name' in data && 'role' in data && 'device' in data && 'consentGiven' in data) &&
             checkStringSize(data.email, 5, 200) &&
             checkStringSize(data.name, 2, 100) &&
             data.role in ['ATHLETE', 'COACH', 'CLUB'] &&
             data.device in ['GARMIN', 'WAHOO', 'SRM', 'OTHER'] &&
             data.consentGiven == true &&
             (!('notes' in data) || checkOptionalStringSize(data.notes, 1, 500)) &&
             data.keys().size() <= 10;
    }

    function isValidRaceDoc(data, userId) {
      let requiredOk = ('title' in data && 'date' in data && 'priority' in data);
      let titleOk = checkStringSize(data.title, 1, 150);
      let dateOk = checkStringSize(data.date, 8, 12);
      let priorityOk = data.priority in ['A', 'B', 'C'];
      let sportOk = !('sport' in data) || data.sport in ['BIKE', 'RUN', 'SWIM', 'TRIATHLON', 'OTHER'];
      let distanceOk = !('distanceLabel' in data) || checkOptionalStringSize(data.distanceLabel, 1, 100);
      let notesOk = !('notes' in data) || checkOptionalStringSize(data.notes, 1, 2000);
      let timeOk = !('targetTimeSec' in data) || (data.targetTimeSec is number && data.targetTimeSec >= 0);
      let powerOk = !('targetPowerWatts' in data) || (data.targetPowerWatts is number && data.targetPowerWatts >= 0);
      let userOk = !('userId' in data) || data.userId == userId;
      let sizeOk = data.keys().size() <= 15;
      
      return requiredOk && titleOk && dateOk && priorityOk && sportOk && distanceOk && notesOk && timeOk && powerOk && userOk && sizeOk;
    }

    // ===============================================================
    // Security Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(request.resource.data);
      allow update: if isOwner(userId) && isValidUserUpdate();
      
      match /thresholdHistory/{historyId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }

      match /consents/{consentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }

      match /private/{privateId} {
        allow read, write: if false;
      }
      
      match /dailyMetrics/{date} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForHealth(userId));
        allow create, update: if isOwner(userId); // Prototype for now
        allow delete: if isOwner(userId);
      }

      match /aggregates/{date} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForActivities(userId));
        allow write: if false; // Only Cloud Functions
      }

      match /bests/{sport} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForActivities(userId));
        allow write: if false; // Only Cloud Functions
      }

      match /thresholdProposals/{proposalId} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForActivities(userId));
        allow create: if isAuthenticated() &&
          isCoachForActivities(userId) &&
          isValidCoachThresholdProposalCreate(request.resource.data);
        allow update: if isOwner(userId) && isValidThresholdProposalUpdate();
        allow delete: if isOwner(userId);
      }

      match /integrationStatus/{provider} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDeviceDoc(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notificationState/{docId} {
        allow read: if isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      match /preferences/{prefId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPreferenceDoc(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /races/{raceId} {
        allow read: if isOwner(userId) || (isAuthenticated() && isCoachForCalendar(userId));
        allow create: if (isOwner(userId) || (isAuthenticated() && isCoachForCalendar(userId))) && isValidRaceDoc(request.resource.data, userId);
        allow update: if (isOwner(userId) || (isAuthenticated() && isCoachForCalendar(userId))) && isValidRaceDoc(request.resource.data, userId);
        allow delete: if isOwner(userId) || (isAuthenticated() && isCoachForCalendar(userId));
      }
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false; // Only server-side
    }

    match /coachLinks/{linkId} {
      allow read: if isAuthenticated() && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid);
      allow write: if false; // Only backend can write
    }

    match /invites/{code} {
      allow read: if isAuthenticated();
      allow write: if false; // Only backend can write
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        (resource.data.coachId == request.auth.uid && isCoachForActivities(resource.data.athleteId))
      );
      allow create: if isAuthenticated() && request.resource.data.athleteId == request.auth.uid; // Prototype
      allow update: if isAuthenticated() && resource.data.athleteId == request.auth.uid && request.resource.data.athleteId == resource.data.athleteId; // Prototype, immutable athleteId
      allow delete: if isAuthenticated() && resource.data.athleteId == request.auth.uid;
    }

    match /plannedWorkouts/{workoutId} {
      allow read: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        isCoachForCalendar(resource.data.athleteId)
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.athleteId == request.auth.uid && request.resource.data.createdBy == request.auth.uid) ||
        (isCoachForCalendar(request.resource.data.athleteId) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        (resource.data.athleteId == request.auth.uid || isCoachForCalendar(resource.data.athleteId)) &&
        request.resource.data.athleteId == resource.data.athleteId &&
        request.resource.data.createdBy == resource.data.createdBy
      );
      allow delete: if isAuthenticated() && (
        resource.data.athleteId == request.auth.uid ||
        (resource.data.createdBy == request.auth.uid && isCoachForCalendar(resource.data.athleteId))
      );
    }

    match /workoutTemplates/{templateId} {
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'PUBLIC' ||
        resource.data.ownerId == request.auth.uid ||
        (
          resource.data.visibility == 'SHARED_WITH_MY_ATHLETES' &&
          exists(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + resource.data.ownerId)) &&
          get(/databases/$(database)/documents/coachLinks/$(request.auth.uid + '_' + resource.data.ownerId)).data.status == 'ACTIVE'
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.visibility in ['PRIVATE', 'SHARED_WITH_MY_ATHLETES', 'PUBLIC'] &&
        isValidWorkoutTemplate(request.resource.data);
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        isValidWorkoutTemplate(request.resource.data);
      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        isChatParticipant(chatId) ||
        (resource != null && (resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid))
      );
      allow write: if false; // Only Cloud Functions (erzeugt bei aktiver Verknüpfung, verwaltet lastMessage/unread)

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) &&
          isChatActive(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          isValidMessageCreate(request.resource.data);
        allow update: if isChatParticipant(chatId) &&
          isValidMessageUpdate();
        allow delete: if false; // Ausschließlich Soft-Delete über update
      }

      match /state/{uid} {
        allow read: if isChatParticipant(chatId);
        allow create, update: if isChatParticipant(chatId) &&
          isOwner(uid) &&
          isValidChatState(request.resource.data);
        allow delete: if false;
      }
    }

    match /coachDashboard/{coachId}/athletes/{athleteId} {
      allow read: if isAuthenticated() && request.auth.uid == coachId;
      allow write: if false; // Only Cloud Functions
    }

    match /betaFeedback/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidBetaFeedbackCreate(request.resource.data);
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'];
      allow delete: if false;
    }

    match /beta_feedback/{reportId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidBetaFeedbackCreate(request.resource.data);
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'];
      allow delete: if false;
    }

    match /betaWaitlist/{entryId} {
      allow create: if isValidBetaWaitlistEntry(request.resource.data);
      allow read, update, delete: if false;
    }

    match /contactRequests/{requestId} {
      allow create: if isValidContactRequest(request.resource.data);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if false; // Server/Admin only
    }
  }
}
